{
  "name": "ts-front",
  "version": "1.0.0",
  "description": "Example decoupled (headless) front-end for a Drupal CMS — React + TypeScript region components.",
  "repository": "github:dotmundo/ts-front",
  "author": "Raul R <raulrodrigueznyc@gmail.com>",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && esbuild html/src/front.ts --bundle --outfile=html/dist/front.js --format=iife --sourcemap",
    "watch": "esbuild html/src/front.ts --bundle --outfile=html/dist/front.js --format=iife --sourcemap --watch"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
